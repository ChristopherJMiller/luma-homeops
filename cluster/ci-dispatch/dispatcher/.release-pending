#   git.realliance.net/realliance-ops/ci-dispatch:sha-PENDING@sha256:<64 zeros>
# and test_dispatcher_image_pending (scripts/test_ci_dispatch_manifests.py) passes only when the
# checked-out branch is the one named below. A commit anywhere else, main included, fails the
# ci-dispatch-manifests pre-commit hook until the release is pinned.
#
# Task 19's re-pin is ONE commit that does all three:
#   1. deletes this file;
#   2. sets the StatefulSet image to v0.2.0's sha-<7>@sha256:<64> (the digest Task 16 ledgered);
#   3. sets RELEASE_IMAGE in scripts/test_ci_dispatch_manifests.py to the same string.
#
# A fast-forward or a conflict-free merge runs no hook, so before pushing to main also check that
# `git grep -n sha-PENDING -- cluster/` prints nothing.
branch: ci-phase2-manifests
