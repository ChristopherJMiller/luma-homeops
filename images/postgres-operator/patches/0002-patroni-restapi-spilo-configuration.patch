From d514b175682aa3019f8e2f93f68373a1973049b9 Mon Sep 17 00:00:00 2001
From: Christopher Miller <git@chrismiller.xyz>
Date: Thu, 22 Oct 2026 08:25:11 -0700
Subject: [PATCH] cluster: opt-in Patroni REST API auth in SPILO_CONFIGURATION
 from CR env

---
 pkg/cluster/k8sres.go                    |  16 +-
 pkg/cluster/patroni_restapi_auth.go      |  79 ++++++++
 pkg/cluster/patroni_restapi_auth_test.go | 229 +++++++++++++++++++++++
 3 files changed, 323 insertions(+), 1 deletion(-)
 create mode 100644 pkg/cluster/patroni_restapi_auth.go
 create mode 100644 pkg/cluster/patroni_restapi_auth_test.go

diff --git a/pkg/cluster/k8sres.go b/pkg/cluster/k8sres.go
index 2cd1a96e..0970df63 100644
--- a/pkg/cluster/k8sres.go
+++ b/pkg/cluster/k8sres.go
@@ -73,6 +73,8 @@ type pgBootstrap struct {
 type spiloConfiguration struct {
 	PgLocalConfiguration map[string]interface{} `json:"postgresql"`
 	Bootstrap            pgBootstrap            `json:"bootstrap"`
+	// galaxy patch: last and omitempty, so a CR that doesn't opt in marshals byte-identically.
+	RestAPI *spiloRestAPI `json:"restapi,omitempty"`
 }
 
 func (c *Cluster) statefulSetName() string {
@@ -361,6 +363,12 @@ func (c *Cluster) generateResourceRequirements(
 }
 
 func generateSpiloJSONConfiguration(pg *acidv1.PostgresqlParam, patroni *acidv1.Patroni, opConfig *config.Config, logger *logrus.Entry) (string, error) {
+	return generateSpiloJSONConfigurationWithRESTAPIAuth(pg, patroni, opConfig, false, logger)
+}
+
+// galaxy patch: restAPIAuth adds restapi.authentication with $(VAR) references to the
+// PATRONI_RESTAPI_* env vars; see patroni_restapi_auth.go.
+func generateSpiloJSONConfigurationWithRESTAPIAuth(pg *acidv1.PostgresqlParam, patroni *acidv1.Patroni, opConfig *config.Config, restAPIAuth bool, logger *logrus.Entry) (string, error) {
 	config := spiloConfiguration{}
 
 	config.Bootstrap = pgBootstrap{}
@@ -474,6 +482,9 @@ PatroniInitDBParams:
 	if len(patroni.PgHba) > 0 {
 		config.PgLocalConfiguration[patroniPGHBAConfParameterName] = patroni.PgHba
 	}
+	if restAPIAuth {
+		config.RestAPI = patroniRESTAPIAuthentication()
+	}
 
 	res, err := json.Marshal(config)
 	return string(res), err
@@ -1004,6 +1015,9 @@ func (c *Cluster) generateSpiloPodEnvVars(
 	} else {
 		envVars = append(envVars, v1.EnvVar{Name: "KUBERNETES_LABELS", Value: string(clusterLabels)})
 	}
+	// galaxy patch: the kubelet only expands $(VAR) in SPILO_CONFIGURATION for vars listed
+	// before it; the later appendEnvVars(envVars, spec.Env...) skips these (first wins).
+	envVars = append(envVars, patroniRESTAPIAuthEnv(spec.Env)...)
 	if spiloConfiguration != "" {
 		envVars = append(envVars, v1.EnvVar{Name: "SPILO_CONFIGURATION", Value: spiloConfiguration})
 	}
@@ -1323,7 +1337,7 @@ func (c *Cluster) generateStatefulSet(spec *acidv1.PostgresSpec) (*appsv1.Statef
 		}
 	}
 
-	spiloConfiguration, err := generateSpiloJSONConfiguration(&spec.PostgresqlParam, &spec.Patroni, &c.OpConfig, c.logger)
+	spiloConfiguration, err := generateSpiloJSONConfigurationWithRESTAPIAuth(&spec.PostgresqlParam, &spec.Patroni, &c.OpConfig, patroniRESTAPIAuthEnv(spec.Env) != nil, c.logger)
 	if err != nil {
 		return nil, fmt.Errorf("could not generate Spilo JSON configuration: %v", err)
 	}
diff --git a/pkg/cluster/patroni_restapi_auth.go b/pkg/cluster/patroni_restapi_auth.go
new file mode 100644
index 00000000..be4fba8f
--- /dev/null
+++ b/pkg/cluster/patroni_restapi_auth.go
@@ -0,0 +1,79 @@
+// galaxy patch — luma-homeops docs/postgres.md
+//
+// Per-CR opt-in to Patroni REST API auth. A CR opts in by listing both
+// PATRONI_RESTAPI_USERNAME and PATRONI_RESTAPI_PASSWORD in spec.env as
+// secretKeyRefs to the Secret patroni-restapi, keys username and password. The
+// operator then emits those two entries (never optional) before
+// SPILO_CONFIGURATION and adds
+// restapi.authentication = {username: $(PATRONI_RESTAPI_USERNAME), password: $(PATRONI_RESTAPI_PASSWORD)}
+// to it; the kubelet expands the $(VAR) references because the vars come
+// earlier in the list. The StatefulSet holds only the references. A CR that
+// does not opt in gets a byte-identical StatefulSet.
+
+package cluster
+
+import (
+	"github.com/zalando/postgres-operator/pkg/util/patroni"
+	v1 "k8s.io/api/core/v1"
+)
+
+const (
+	patroniRESTAPIUsernameEnv = "PATRONI_RESTAPI_USERNAME"
+	patroniRESTAPIPasswordEnv = "PATRONI_RESTAPI_PASSWORD"
+)
+
+// spiloRestAPI is the restapi section of SPILO_CONFIGURATION. Spilo deep-merges
+// it into its template, next to listen and connect_address.
+type spiloRestAPI struct {
+	Authentication map[string]string `json:"authentication"`
+}
+
+// patroniRESTAPIAuthEnv returns [username, password] env entries when the CR
+// opts in. Opting in means the first exact-case PATRONI_RESTAPI_USERNAME entry
+// is a secretKeyRef to patroni-restapi key "username", and the first exact-case
+// PATRONI_RESTAPI_PASSWORD entry is a secretKeyRef to patroni-restapi key
+// "password". Otherwise it returns nil.
+//
+// The entries are copies of the CR's with Optional cleared (D7): a missing
+// Secret must fail the pod closed rather than leave a literal $(…) as the
+// password. The CR's env is not modified.
+//
+// Matching here is exact-case, but appendEnvVars deduplicates case-insensitively
+// (isEnvVarPresent uses strings.EqualFold). So once these two are injected, every
+// later spec.Env entry with either name, in any case, is dropped.
+func patroniRESTAPIAuthEnv(env []v1.EnvVar) []v1.EnvVar {
+	username, okUsername := firstEnvVar(env, patroniRESTAPIUsernameEnv)
+	password, okPassword := firstEnvVar(env, patroniRESTAPIPasswordEnv)
+	if !okUsername || !okPassword || !refsRESTAPISecret(username, "username") || !refsRESTAPISecret(password, "password") {
+		return nil
+	}
+	return []v1.EnvVar{nonOptional(username), nonOptional(password)}
+}
+
+func firstEnvVar(env []v1.EnvVar, name string) (v1.EnvVar, bool) {
+	for _, e := range env {
+		if e.Name == name {
+			return e, true
+		}
+	}
+	return v1.EnvVar{}, false
+}
+
+func refsRESTAPISecret(e v1.EnvVar, key string) bool {
+	return e.ValueFrom != nil && e.ValueFrom.SecretKeyRef != nil &&
+		e.ValueFrom.SecretKeyRef.Name == patroni.PatroniRESTAPISecretName &&
+		e.ValueFrom.SecretKeyRef.Key == key
+}
+
+func nonOptional(e v1.EnvVar) v1.EnvVar {
+	out := *e.DeepCopy()
+	out.ValueFrom.SecretKeyRef.Optional = nil
+	return out
+}
+
+func patroniRESTAPIAuthentication() *spiloRestAPI {
+	return &spiloRestAPI{Authentication: map[string]string{
+		"username": "$(" + patroniRESTAPIUsernameEnv + ")",
+		"password": "$(" + patroniRESTAPIPasswordEnv + ")",
+	}}
+}
diff --git a/pkg/cluster/patroni_restapi_auth_test.go b/pkg/cluster/patroni_restapi_auth_test.go
new file mode 100644
index 00000000..49946921
--- /dev/null
+++ b/pkg/cluster/patroni_restapi_auth_test.go
@@ -0,0 +1,229 @@
+// galaxy patch — luma-homeops docs/postgres.md
+
+package cluster
+
+import (
+	"encoding/json"
+	"reflect"
+	"testing"
+
+	"github.com/sirupsen/logrus"
+	acidv1 "github.com/zalando/postgres-operator/pkg/apis/acid.zalan.do/v1"
+	"github.com/zalando/postgres-operator/pkg/util/config"
+	"github.com/zalando/postgres-operator/pkg/util/constants"
+	"github.com/zalando/postgres-operator/pkg/util/k8sutil"
+	v1 "k8s.io/api/core/v1"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/client-go/tools/record"
+)
+
+var restAPIAuthLogger = logrus.New().WithField("test", "patroni-restapi-auth")
+
+func secretRefEnv(name, secret, key string) v1.EnvVar {
+	return v1.EnvVar{
+		Name: name,
+		ValueFrom: &v1.EnvVarSource{
+			SecretKeyRef: &v1.SecretKeySelector{
+				LocalObjectReference: v1.LocalObjectReference{Name: secret},
+				Key:                  key,
+			},
+		},
+	}
+}
+
+var (
+	restAPIUsernameRef = secretRefEnv(patroniRESTAPIUsernameEnv, "patroni-restapi", "username")
+	restAPIPasswordRef = secretRefEnv(patroniRESTAPIPasswordEnv, "patroni-restapi", "password")
+)
+
+func optionalRef(e v1.EnvVar) v1.EnvVar {
+	out := *e.DeepCopy()
+	optional := true
+	out.ValueFrom.SecretKeyRef.Optional = &optional
+	return out
+}
+
+func TestPatroniRESTAPIAuthEnv(t *testing.T) {
+	tests := []struct {
+		name string
+		env  []v1.EnvVar
+		want []v1.EnvVar
+	}{
+		{
+			name: "both refs to patroni-restapi, password listed first",
+			env:  []v1.EnvVar{{Name: "FOO", Value: "bar"}, restAPIPasswordRef, restAPIUsernameRef},
+			want: []v1.EnvVar{restAPIUsernameRef, restAPIPasswordRef},
+		},
+		{
+			name: "only one name",
+			env:  []v1.EnvVar{restAPIUsernameRef},
+		},
+		{
+			name: "plain values",
+			env: []v1.EnvVar{
+				{Name: patroniRESTAPIUsernameEnv, Value: "patroni"},
+				{Name: patroniRESTAPIPasswordEnv, Value: "not-a-secret"},
+			},
+		},
+		{
+			name: "refs to another Secret",
+			env: []v1.EnvVar{
+				secretRefEnv(patroniRESTAPIUsernameEnv, "foo", "username"),
+				secretRefEnv(patroniRESTAPIPasswordEnv, "foo", "password"),
+			},
+		},
+		{
+			name: "lowercase names",
+			env: []v1.EnvVar{
+				secretRefEnv("patroni_restapi_username", "patroni-restapi", "username"),
+				secretRefEnv("patroni_restapi_password", "patroni-restapi", "password"),
+			},
+		},
+		{
+			name: "keys swapped",
+			env: []v1.EnvVar{
+				secretRefEnv(patroniRESTAPIUsernameEnv, "patroni-restapi", "password"),
+				secretRefEnv(patroniRESTAPIPasswordEnv, "patroni-restapi", "username"),
+			},
+		},
+		{
+			name: "wrong username key",
+			env:  []v1.EnvVar{secretRefEnv(patroniRESTAPIUsernameEnv, "patroni-restapi", "user"), restAPIPasswordRef},
+		},
+		{
+			name: "wrong password key",
+			env:  []v1.EnvVar{restAPIUsernameRef, secretRefEnv(patroniRESTAPIPasswordEnv, "patroni-restapi", "pass")},
+		},
+		{
+			// D7: the injected copies are never optional, so a missing Secret fails the
+			// pod closed (CreateContainerConfigError) instead of leaving a literal $(…).
+			name: "optional refs come back non-optional",
+			env:  []v1.EnvVar{optionalRef(restAPIUsernameRef), optionalRef(restAPIPasswordRef)},
+			want: []v1.EnvVar{restAPIUsernameRef, restAPIPasswordRef},
+		},
+		{
+			name: "no env",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			var before []v1.EnvVar
+			for i := range tt.env {
+				before = append(before, *tt.env[i].DeepCopy())
+			}
+			got := patroniRESTAPIAuthEnv(tt.env)
+			if !reflect.DeepEqual(got, tt.want) {
+				t.Errorf("patroniRESTAPIAuthEnv() = %+v, want %+v", got, tt.want)
+			}
+			if !reflect.DeepEqual(tt.env, before) {
+				t.Errorf("patroniRESTAPIAuthEnv modified the CR's env: %+v, was %+v", tt.env, before)
+			}
+		})
+	}
+}
+
+func restAPIAuthTestCluster(spec acidv1.PostgresSpec) *Cluster {
+	return New(
+		Config{
+			OpConfig: config.Config{
+				PodManagementPolicy: "ordered_ready",
+				ProtectedRoles:      []string{"admin"},
+				Auth: config.Auth{
+					SuperUsername:       "postgres",
+					ReplicationUsername: "standby",
+				},
+				EnablePgVersionEnvVar: true,
+			},
+		},
+		k8sutil.KubernetesClient{},
+		acidv1.Postgresql{
+			ObjectMeta: metav1.ObjectMeta{Name: "acid-royaltracker", Namespace: "royaltracker"},
+			Spec:       spec,
+		},
+		restAPIAuthLogger,
+		record.NewFakeRecorder(10),
+	)
+}
+
+func TestGenerateStatefulSetPatroniRESTAPIAuth(t *testing.T) {
+	spec := acidv1.PostgresSpec{
+		PostgresqlParam:   acidv1.PostgresqlParam{PgVersion: "16"},
+		TeamID:            "acid",
+		NumberOfInstances: 2,
+		Volume:            acidv1.Volume{Size: "1G"},
+		Env:               []v1.EnvVar{{Name: "FOO", Value: "bar"}, restAPIPasswordRef, restAPIUsernameRef},
+	}
+	sts, err := restAPIAuthTestCluster(spec).generateStatefulSet(&spec)
+	if err != nil {
+		t.Fatalf("generateStatefulSet: %v", err)
+	}
+
+	var env []v1.EnvVar
+	for _, c := range sts.Spec.Template.Spec.Containers {
+		if c.Name == constants.PostgresContainerName {
+			env = c.Env
+		}
+	}
+	index := map[string]int{}
+	count := map[string]int{}
+	for i, e := range env {
+		if _, seen := index[e.Name]; !seen {
+			index[e.Name] = i
+		}
+		count[e.Name]++
+	}
+
+	for _, name := range []string{patroniRESTAPIUsernameEnv, patroniRESTAPIPasswordEnv, "SPILO_CONFIGURATION", "FOO"} {
+		if count[name] != 1 {
+			t.Fatalf("%s appears %d times in the postgres container env, want 1", name, count[name])
+		}
+	}
+	if !(index[patroniRESTAPIUsernameEnv] < index[patroniRESTAPIPasswordEnv] &&
+		index[patroniRESTAPIPasswordEnv] < index["SPILO_CONFIGURATION"]) {
+		t.Errorf("env order: USERNAME at %d, PASSWORD at %d, SPILO_CONFIGURATION at %d; want USERNAME < PASSWORD < SPILO_CONFIGURATION",
+			index[patroniRESTAPIUsernameEnv], index[patroniRESTAPIPasswordEnv], index["SPILO_CONFIGURATION"])
+	}
+	if got := env[index[patroniRESTAPIUsernameEnv]].ValueFrom; !reflect.DeepEqual(got, restAPIUsernameRef.ValueFrom) {
+		t.Errorf("USERNAME ValueFrom = %+v, want the CR's %+v", got, restAPIUsernameRef.ValueFrom)
+	}
+	if got := env[index[patroniRESTAPIPasswordEnv]].ValueFrom; !reflect.DeepEqual(got, restAPIPasswordRef.ValueFrom) {
+		t.Errorf("PASSWORD ValueFrom = %+v, want the CR's %+v", got, restAPIPasswordRef.ValueFrom)
+	}
+
+	var spilo map[string]interface{}
+	if err := json.Unmarshal([]byte(env[index["SPILO_CONFIGURATION"]].Value), &spilo); err != nil {
+		t.Fatalf("could not decode SPILO_CONFIGURATION: %v", err)
+	}
+	want := map[string]interface{}{
+		"authentication": map[string]interface{}{
+			"password": "$(PATRONI_RESTAPI_PASSWORD)",
+			"username": "$(PATRONI_RESTAPI_USERNAME)",
+		},
+	}
+	if !reflect.DeepEqual(spilo["restapi"], want) {
+		t.Errorf("SPILO_CONFIGURATION restapi = %#v, want %#v", spilo["restapi"], want)
+	}
+}
+
+func TestCompareSpiloConfigurationSeesRESTAPI(t *testing.T) {
+	pg := acidv1.PostgresqlParam{PgVersion: "16", Parameters: map[string]string{"synchronous_commit": "off"}}
+	failsafe := true
+	patroni := acidv1.Patroni{FailsafeMode: &failsafe}
+	opConfig := config.Config{EnablePgVersionEnvVar: true}
+
+	withAuth, err := generateSpiloJSONConfigurationWithRESTAPIAuth(&pg, &patroni, &opConfig, true, restAPIAuthLogger)
+	if err != nil {
+		t.Fatalf("with auth: %v", err)
+	}
+	withoutAuth, err := generateSpiloJSONConfigurationWithRESTAPIAuth(&pg, &patroni, &opConfig, false, restAPIAuthLogger)
+	if err != nil {
+		t.Fatalf("without auth: %v", err)
+	}
+
+	if compareSpiloConfiguration(withAuth, withoutAuth) {
+		t.Error("compareSpiloConfiguration(withAuth, withoutAuth) = true; opting in or out would not roll the cluster")
+	}
+	if !compareSpiloConfiguration(withAuth, withAuth) {
+		t.Error("compareSpiloConfiguration(withAuth, withAuth) = false, want true")
+	}
+}
