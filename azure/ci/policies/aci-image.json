{
  "displayName": "Realliance CI: the class image, by digest",
  "description": "Runner classes spec, layer 5. Every container runs ghcr.io/christopherjmiller/forgejo-runner-class in the digest-only form name@sha256:, the form the dispatcher sends (F16): no tag and no other package. The contains check repeats the digest rule.",
  "mode": "Indexed",
  "policyRule": {
    "if": {
      "allOf": [
        {"field": "type", "equals": "Microsoft.ContainerInstance/containerGroups"},
        {
          "count": {
            "field": "Microsoft.ContainerInstance/containerGroups/containers[*]",
            "where": {
              "anyOf": [
                {"field": "Microsoft.ContainerInstance/containerGroups/containers[*].image", "notLike": "ghcr.io/christopherjmiller/forgejo-runner-class@sha256:*"},
                {"field": "Microsoft.ContainerInstance/containerGroups/containers[*].image", "notContains": "@sha256:"}
              ]
            }
          },
          "greater": 0
        }
      ]
    },
    "then": {
      "effect": "deny"
    }
  }
}
